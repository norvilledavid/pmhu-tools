      <div class="log-date">${e.date}</div>
      <div class="log-thing">${e.oneThing}</div>
      ${e.finished ? `<div class="log-notes"><strong>Finished:</strong> ${e.finished}</div>` : ''}
      ${e.carried ? `<div class="log-notes"><strong>Carried:</strong> ${e.carried}</div>` : ''}
    </div>
  `).join('');
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}

init();
</script>
</body>
</html>
