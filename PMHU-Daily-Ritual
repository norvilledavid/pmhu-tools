<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PMHU Daily Ritual</title>
<style>
  :root {
    --bg: #F7F6F2;
    --surface: #FFFFFF;
    --surface-2: #F0EEE9;
    --border: rgba(0,0,0,0.09);
    --border-strong: rgba(0,0,0,0.18);
    --text: #1A1917;
    --text-muted: #6B6860;
    --text-faint: #A09D96;
    --accent: #1D5FA8;
    --accent-bg: #EBF2FC;
    --accent-text: #0C3D6E;
    --green: #2E7D52;
    --green-bg: #E8F5EE;
    --amber: #8A5C00;
    --amber-bg: #FDF3DC;
    --red: #B83232;
    --red-bg: #FCEAEA;
    --gray: #6B6860;
    --gray-bg: #F0EEE9;
    --purple: #5A3FA8;
    --purple-bg: #EEEAFE;
    --teal: #1A7A62;
    --teal-bg: #E3F5EF;
    --coral: #B84020;
    --coral-bg: #FAECEA;
    --pink: #A03060;
    --pink-bg: #FAE8F0;
    --radius: 10px;
    --radius-sm: 6px;
    --shadow: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    min-height: 100vh;
  }

  /* SETUP SCREEN */
  #setup-screen {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .setup-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2.5rem;
    max-width: 480px;
    width: 100%;
    box-shadow: var(--shadow);
  }

  .setup-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 2rem;
  }

  .setup-logo-mark {
    width: 32px;
    height: 32px;
    background: var(--text);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bg);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .setup-logo-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.2px;
  }

  .setup-card h1 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.4px;
    margin-bottom: 0.4rem;
  }

  .setup-card p {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
    line-height: 1.6;
  }

  .field-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .api-input {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-family: 'SF Mono', 'Fira Code', monospace;
    background: var(--surface);
    color: var(--text);
    outline: none;
    transition: border-color 0.15s;
    margin-bottom: 1rem;
  }

  .api-input:focus { border-color: var(--accent); }

  .api-hint {
    font-size: 12px;
    color: var(--text-faint);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .api-hint a { color: var(--accent); text-decoration: none; }
  .api-hint a:hover { text-decoration: underline; }

  .btn-primary {
    width: 100%;
    padding: 11px;
    background: var(--text);
    color: var(--bg);
    border: none;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .btn-primary:hover { opacity: 0.85; }
  .btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }

  /* MAIN APP */
  #app-screen { display: none; }

  .app-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    min-height: 100vh;
  }

  /* SIDEBAR */
  .sidebar {
    background: var(--surface);
    border-right: 1px solid var(--border);
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
  }

  .sidebar-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 2rem;
    padding: 0 0.25rem;
  }

  .logo-mark {
    width: 26px;
    height: 26px;
    background: var(--text);
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bg);
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .logo-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.2px;
  }

  .nav-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    padding: 0 0.5rem;
    margin-bottom: 0.4rem;
    margin-top: 1.25rem;
  }

  .nav-label:first-of-type { margin-top: 0; }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 13px;
    color: var(--text-muted);
    transition: all 0.12s;
    border: none;
    background: none;
    width: 100%;
    text-align: left;
  }

  .nav-item:hover { background: var(--surface-2); color: var(--text); }

  .nav-item.active {
    background: var(--accent-bg);
    color: var(--accent-text);
    font-weight: 500;
  }

  .nav-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-left: auto;
  }

  .dot-green { background: var(--green); }
  .dot-amber { background: #D4890A; }
  .dot-red { background: var(--red); }
  .dot-gray { background: var(--text-faint); }

  .phase-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .phase-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 13px;
    color: var(--text-muted);
    transition: all 0.12s;
    border: none;
    background: none;
    width: 100%;
    text-align: left;
  }

  .phase-btn:hover { background: var(--surface-2); color: var(--text); }
  .phase-btn.active { background: var(--surface-2); color: var(--text); font-weight: 500; }

  .phase-num-sm {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 600;
    flex-shrink: 0;
  }

  .sidebar-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .btn-ghost {
    width: 100%;
    padding: 7px 10px;
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: 12px;
    color: var(--text-muted);
    cursor: pointer;
    text-align: left;
    transition: all 0.12s;
  }

  .btn-ghost:hover { background: var(--surface-2); color: var(--text); }

  /* MAIN CONTENT */
  .main-content {
    padding: 2.5rem 3rem;
    max-width: 780px;
  }

  .page-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.5px;
    color: var(--text);
  }

  .page-date {
    font-size: 13px;
    color: var(--text-faint);
  }

  .phase-block {
    display: none;
  }

  .phase-block.visible {
    display: block;
  }

  /* PHASE HEADERS */
  .phase-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.25rem;
  }

  .phase-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .phase-time-tag {
    font-size: 12px;
    color: var(--text-faint);
    margin-left: auto;
  }

  /* GROUND PHASE */
  .ground-questions { display: flex; flex-direction: column; gap: 10px; }

  .ground-q {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    box-shadow: var(--shadow);
  }

  .ground-q-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-faint);
    margin-bottom: 6px;
  }

  .ground-q-prompt {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 10px;
    line-height: 1.5;
  }

  .ground-input {
    width: 100%;
    border: none;
    outline: none;
    font-size: 14px;
    font-family: inherit;
    color: var(--text);
    background: transparent;
    resize: none;
    min-height: 40px;
  }

  .ground-input::placeholder { color: var(--text-faint); }

  /* SCAN PHASE */
  .domain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 1.5rem;
  }

  .domain-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    cursor: pointer;
    transition: all 0.12s;
    box-shadow: var(--shadow);
    position: relative;
  }

  .domain-card:hover { border-color: var(--border-strong); transform: translateY(-1px); }
  .domain-card.selected { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-bg); }

  .dc-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }

  .dc-icon { font-size: 18px; }

  .dc-label { font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 3px; }

  .dc-sub { font-size: 11px; color: var(--text-muted); line-height: 1.4; }

  /* DOMAIN DETAIL */
  .domain-detail {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .dd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .dd-title { font-size: 14px; font-weight: 600; color: var(--text); }

  .dd-close {
    font-size: 12px;
    color: var(--text-muted);
    border: 1px solid var(--border-strong);
    background: none;
    border-radius: var(--radius-sm);
    padding: 4px 10px;
    cursor: pointer;
  }

  .dd-close:hover { background: var(--surface-2); }

  .dd-questions { padding: 1rem 1.25rem; }

  .dd-q {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }

  .dd-q:last-child { border-bottom: none; }

  .dd-q-label { font-size: 13px; font-weight: 500; color: var(--text); margin-bottom: 3px; }
  .dd-q-hint { font-size: 12px; color: var(--text-muted); line-height: 1.5; }

  .dd-actions {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 8px;
  }

  .btn-ask {
    flex: 1;
    padding: 9px 14px;
    background: var(--text);
    color: var(--bg);
    border: none;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.12s;
  }

  .btn-ask:hover { opacity: 0.8; }
  .btn-ask:disabled { opacity: 0.4; cursor: not-allowed; }

  /* COMMIT PHASE */
  .one-thing-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
    margin-bottom: 1rem;
  }

  .one-thing-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    margin-bottom: 10px;
  }

  .one-thing-input {
    width: 100%;
    border: none;
    outline: none;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.3px;
    font-family: inherit;
    color: var(--text);
    background: transparent;
  }

  .one-thing-input::placeholder { color: var(--text-faint); font-weight: 400; }

  .commit-rule {
    background: var(--surface-2);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .commit-rule strong { color: var(--text); font-weight: 600; }

  /* LOG */
  .log-entry {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin-bottom: 8px;
    box-shadow: var(--shadow);
  }

  .log-date { font-size: 11px; color: var(--text-faint); margin-bottom: 4px; font-weight: 500; }
  .log-thing { font-size: 14px; font-weight: 500; color: var(--text); margin-bottom: 6px; }
  .log-notes { font-size: 12px; color: var(--text-muted); line-height: 1.5; }

  .empty-log {
    padding: 2rem;
    text-align: center;
    color: var(--text-faint);
    font-size: 13px;
  }

  /* INBOX PHASE */
  .inbox-check {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .inbox-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: background 0.1s;
  }

  .inbox-row:last-child { border-bottom: none; }
  .inbox-row:hover { background: var(--surface-2); }
  .inbox-row.checked { opacity: 0.5; }

  .inbox-check-box {
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--border-strong);
    border-radius: 4px;
    flex-shrink: 0;
    margin-top: 1px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.12s;
  }

  .inbox-row.checked .inbox-check-box {
    background: var(--text);
    border-color: var(--text);
  }

  .inbox-check-box svg { display: none; }
  .inbox-row.checked .inbox-check-box svg { display: block; }

  .inbox-label { font-size: 13px; font-weight: 500; color: var(--text); margin-bottom: 2px; }
  .inbox-q { font-size: 12px; color: var(--text-muted); line-height: 1.5; }

  /* AI RESPONSE PANEL */
  .ai-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin-top: 1rem;
    box-shadow: var(--shadow);
    display: none;
  }

  .ai-panel.visible { display: block; }

  .ai-panel-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }

  .ai-badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 7px;
    background: var(--text);
    color: var(--bg);
    border-radius: 4px;
  }

  .ai-context-label { font-size: 12px; color: var(--text-muted); }

  .ai-panel-body {
    padding: 1.25rem;
    font-size: 13px;
    color: var(--text);
    line-height: 1.7;
    min-height: 80px;
    white-space: pre-wrap;
  }

  .ai-loading {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 13px;
  }

  .pulse {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse 1.2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.3; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1); }
  }

  .btn-save {
    padding: 9px 16px;
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.12s;
  }

  .btn-save:hover { background: var(--surface-2); color: var(--text); }

  .toast {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    background: var(--text);
    color: var(--bg);
    padding: 10px 16px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 500;
    opacity: 0;
    transform: translateY(8px);
    transition: all 0.2s;
    pointer-events: none;
    z-index: 100;
  }

  .toast.show { opacity: 1; transform: translateY(0); }

  .section-hed {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    margin-bottom: 0.75rem;
  }

  .next-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    background: var(--text);
    color: var(--bg);
    border: none;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.12s;
    margin-top: 1.5rem;
  }

  .next-btn:hover { opacity: 0.8; }

  .progress-bar {
    display: flex;
    gap: 4px;
    margin-bottom: 2rem;
  }

  .progress-step {
    height: 3px;
    flex: 1;
    background: var(--border-strong);
    border-radius: 2px;
    transition: background 0.2s;
  }

  .progress-step.done { background: var(--text); }
  .progress-step.current { background: var(--accent); }
</style>
</head>
<body>

<!-- SETUP SCREEN -->
<div id="setup-screen">
  <div class="setup-card">
    <div class="setup-logo">
      <div class="setup-logo-mark">♪</div>
      <span class="setup-logo-name">Project: Music Heals Us</span>
    </div>
    <h1>Daily ritual</h1>
    <p>Your morning command center. Enter your Anthropic API key to enable live briefings for each domain. The key is stored locally in your browser and never sent anywhere except directly to Anthropic.</p>
    <div class="field-label">Anthropic API key</div>
    <input class="api-input" type="password" id="api-key-input" placeholder="sk-ant-api03-…" />
    <p class="api-hint">Get your key at <a href="https://console.anthropic.com/settings/keys" target="_blank">console.anthropic.com</a>. Each morning session costs &lt; $0.02.</p>
    <button class="btn-primary" onclick="saveAndStart()">Start today's ritual →</button>
  </div>
</div>

<!-- MAIN APP -->
<div id="app-screen">
  <div class="app-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <div class="logo-mark">♪</div>
        <span class="logo-name">PMHU Ritual</span>
      </div>

      <div class="nav-label">Phases</div>
      <div class="phase-nav">
        <button class="phase-btn active" id="nav-ground" onclick="showPhase('ground')">
          <div class="phase-num-sm" style="background:var(--accent-bg);color:var(--accent-text);">1</div>
          Ground
        </button>
        <button class="phase-btn" id="nav-scan" onclick="showPhase('scan')">
          <div class="phase-num-sm" style="background:var(--purple-bg);color:var(--purple);">2</div>
          Scan
        </button>
        <button class="phase-btn" id="nav-commit" onclick="showPhase('commit')">
          <div class="phase-num-sm" style="background:var(--green-bg);color:var(--green);">3</div>
          Commit
        </button>
        <button class="phase-btn" id="nav-inbox" onclick="showPhase('inbox')">
          <div class="phase-num-sm" style="background:var(--gray-bg);color:var(--gray);">4</div>
          Inbox
        </button>
      </div>

      <div class="nav-label" style="margin-top:1.5rem;">Domains</div>
      <button class="nav-item" onclick="showPhase('scan'); setTimeout(()=>selectDomain('campaign'),100)">
        <span>📢</span> Campaign
        <span class="nav-dot dot-amber"></span>
      </button>
      <button class="nav-item" onclick="showPhase('scan'); setTimeout(()=>selectDomain('donors'),100)">
        <span>👥</span> Donor pipeline
        <span class="nav-dot dot-green"></span>
      </button>
      <button class="nav-item" onclick="showPhase('scan'); setTimeout(()=>selectDomain('grants'),100)">
        <span>🏛</span> Grants
        <span class="nav-dot dot-red"></span>
      </button>
      <button class="nav-item" onclick="showPhase('scan'); setTimeout(()=>selectDomain('comms'),100)">
        <span>✉️</span> Comms
        <span class="nav-dot dot-amber"></span>
      </button>
      <button class="nav-item" onclick="showPhase('scan'); setTimeout(()=>selectDomain('ops'),100)">
        <span>⚙️</span> Ops & systems
        <span class="nav-dot dot-amber"></span>
      </button>
