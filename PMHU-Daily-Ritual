let currentDomain = null;
let currentPhase = 'ground';
let apiKey = localStorage.getItem('pmhu_api_key') || '';

function init() {
  if (apiKey) {
    showApp();
  }
  const d = new Date();
  const days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const dateStr = `${days[d.getDay()]}, ${months[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
  document.getElementById('app-date').textContent = dateStr;
}

function saveAndStart() {
  const key = document.getElementById('api-key-input').value.trim();
  if (!key || !key.startsWith('sk-')) {
    showToast('Enter a valid Anthropic API key (starts with sk-)');
    return;
  }
  localStorage.setItem('pmhu_api_key', key);
  apiKey = key;
  showApp();
}

function showApp() {
  document.getElementById('setup-screen').style.display = 'none';
  document.getElementById('app-screen').style.display = 'block';
}

function resetKey() {
  localStorage.removeItem('pmhu_api_key');
  document.getElementById('setup-screen').style.display = 'flex';
  document.getElementById('app-screen').style.display = 'none';
}

function showPhase(phase) {
  document.querySelectorAll('.phase-block').forEach(b => b.classList.remove('visible'));
  document.querySelectorAll('.phase-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('phase-' + phase).classList.add('visible');
  const navEl = document.getElementById('nav-' + phase);
  if (navEl) navEl.classList.add('active');
  currentPhase = phase;

  const phases = ['ground','scan','commit','inbox'];
  phases.forEach((p, i) => {
    const el = document.getElementById('prog-' + p);
    if (!el) return;
    const idx = phases.indexOf(phase);
    if (i < idx) { el.className = 'progress-step done'; }
    else if (i === idx) { el.className = 'progress-step current'; }
    else { el.className = 'progress-step'; }
  });

  if (phase === 'log') renderLog();
}

function selectDomain(key) {
  document.querySelectorAll('.domain-card').forEach(c => c.classList.remove('selected'));
  const card = document.getElementById('dc-' + key);
  if (card) card.classList.add('selected');

  currentDomain = key;
  const d = DOMAINS[key];
  document.getElementById('dd-title').textContent = d.label;

  const qContainer = document.getElementById('dd-qs');
  qContainer.innerHTML = d.qs.map(item => `
    <div class="dd-q">
      <div class="dd-q-label">${item.q}</div>
      <div class="dd-q-hint">${item.h}</div>
    </div>
  `).join('');

  document.getElementById('domain-detail').style.display = 'block';
  document.getElementById('ai-panel').classList.remove('visible');
  document.getElementById('ai-panel-body').textContent = '';
}

function closeDomain() {
  document.getElementById('domain-detail').style.display = 'none';
  document.getElementById('ai-panel').classList.remove('visible');
  document.querySelectorAll('.domain-card').forEach(c => c.classList.remove('selected'));
  currentDomain = null;
}

async function requestBriefing() {
  if (!currentDomain) return;
  if (!apiKey) { showToast('API key not set'); return; }

  // Detect local file:// origin — Anthropic API blocks null origins
  if (window.location.protocol === 'file:') {
    const panel = document.getElementById('ai-panel');
    const body = document.getElementById('ai-panel-body');
    panel.classList.add('visible');
    document.getElementById('ai-context-label').textContent = DOMAINS[currentDomain].label;
    body.innerHTML = '<div style="color:var(--amber);font-size:13px;line-height:1.6;"><strong>⚠ Open from GitHub Pages to use live briefings.</strong><br><br>You're currently running this file locally (file://). The Anthropic API blocks requests from local files as a security measure. Open the app from your GitHub Pages URL instead:<br><br><code style="background:var(--surface-2);padding:3px 7px;border-radius:4px;font-size:12px;">https://norvilledavid.github.io/pmhu-tools/PMHU-Daily-Ritual.html</code></div>';
    return;
  }

  const btn = document.getElementById('btn-briefing');
  btn.disabled = true;
  btn.textContent = 'Pulling briefing…';

  const panel = document.getElementById('ai-panel');
  const body = document.getElementById('ai-panel-body');
  const label = document.getElementById('ai-context-label');

  panel.classList.add('visible');
  label.textContent = DOMAINS[currentDomain].label;
  body.innerHTML = '<div class="ai-loading"><div class="pulse"></div> Pulling your briefing…</div>';

  const systemPrompt = DOMAINS[currentDomain].prompt;
  const todayDate = document.getElementById('app-date').textContent;

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01'
      },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 600,
        system: systemPrompt,
        messages: [{
          role: 'user',
          content: `Today is ${todayDate}. Give me my morning briefing for this domain. Be concise, tactical, and direct. Use plain text with short paragraphs — no markdown headers or bullets.`
        }]
      })
    });

    const data = await response.json();

    if (data.error) {
      body.textContent = `Error: ${data.error.message}`;
    } else {
      const text = data.content?.[0]?.text || 'No response received.';
      body.textContent = text;
    }
  } catch (err) {
    body.textContent = `Connection error: ${err.message}. Make sure you're using the GitHub Pages URL, not a local file.`;
  }

  btn.disabled = false;
  btn.textContent = 'Get live briefing from Claude →';
}

function toggleInbox(row) {
  row.classList.toggle('checked');
}

function saveEntry() {
  const oneThing = document.getElementById('one-thing-val').value.trim();
  if (!oneThing) return;

  const entries = JSON.parse(localStorage.getItem('pmhu_ritual_log') || '[]');
  entries.unshift({
    date: new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }),
    oneThing,
    finished: document.getElementById('g-finished').value.trim(),
    carried: document.getElementById('g-carried').value.trim(),
    lever: document.getElementById('g-lever').value.trim(),
    ts: Date.now()
  });
  localStorage.setItem('pmhu_ritual_log', JSON.stringify(entries.slice(0, 60)));
  showToast('Entry saved');
}

function finishRitual() {
  saveEntry();
  showToast('Ritual complete. Go move the needle.');
  setTimeout(() => showPhase('ground'), 1200);
}

function renderLog() {
